{
  "name": "@vira-ui/core",
  "version": "16.0.0",
  "description": "Vira Framework - Declarative UI framework layer over React",
  "author": "Vira Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skrolikov/vira-core"
  },
  "keywords": [
    "vira",
    "framework",
    "react",
    "reactive",
    "signals",
    "ui",
    "declarative"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {},
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^23.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
