{
  "name": "@vira-ui/react",
  "version": "1.1.1",
  "description": "Vira Framework - React hooks for Vira Reactive Protocol",
  "author": "Vira Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skrolikov/vira-core"
  },
  "keywords": [
    "vira",
    "react",
    "hooks",
    "vrp",
    "reactive",
    "websocket"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm build"
  },
  "dependencies": {
    "@vira-ui/core": "workspace:*",
    "react": "^18.2.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}

